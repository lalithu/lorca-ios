<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="26000" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="root-nav">
  <device id="retina6_12" orientation="portrait" appearance="light" />
  <dependencies>
    <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="26000" />
    <capability name="Safe area layout guides" minToolsVersion="9.0" />
    <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
  </dependencies>
  <scenes>
    <scene sceneID="root-nav-scene">
      <objects>
        <navigationController id="root-nav" sceneMemberID="viewController">
          <navigationBar key="navigationBar" contentMode="scaleToFill" largeTitles="YES" id="root-nav-bar">
            <rect key="frame" x="0" y="59" width="393" height="96" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" />
          </navigationBar>
          <connections>
            <segue destination="notes" kind="relationship" relationship="rootViewController" id="root-nav-relation" />
          </connections>
        </navigationController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="root-nav-first" sceneMemberID="firstResponder" />
      </objects>
    </scene>
    <scene sceneID="settings-nav-scene">
      <objects>
        <navigationController id="settings-nav" sceneMemberID="viewController" storyboardIdentifier="SettingsNavigation">
          <navigationBar key="navigationBar" contentMode="scaleToFill" largeTitles="YES" id="settings-nav-bar">
            <rect key="frame" x="0" y="59" width="393" height="96" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" />
          </navigationBar>
          <connections>
            <segue destination="settings" kind="relationship" relationship="rootViewController" id="settings-nav-relation" />
          </connections>
        </navigationController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="settings-nav-first" sceneMemberID="firstResponder" />
      </objects>
    </scene>
    <scene sceneID="notes-scene">
      <objects>
        <viewController id="notes" sceneMemberID="viewController" customClass="NotesViewController" customModule="LorcaIOS" customModuleProvider="target">
          <view key="view" contentMode="scaleToFill" id="notes-view">
            <rect key="frame" x="0" y="0" width="393" height="852" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
            <subviews>
              <tableView clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" style="plain" separatorStyle="singleLine" rowHeight="84" estimatedRowHeight="84" sectionHeaderHeight="28" sectionFooterHeight="28" translatesAutoresizingMaskIntoConstraints="NO" id="notes-table">
                <rect key="frame" x="0" y="0" width="393" height="852" />
              </tableView>
              <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Your thoughts, with room to grow.&#10;Tap + to write your first note." numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="empty-label" textAlignment="center">
                <rect key="frame" x="0" y="0" width="349" height="50" />
                <fontDescription key="fontDescription" type="system" pointSize="19" />
              </label>
            </subviews>
            <viewLayoutGuide key="safeArea" id="notes-safe" />
            <constraints>
              <constraint firstItem="notes-table" firstAttribute="top" id="constraint-1" secondItem="notes-safe" secondAttribute="top" />
              <constraint firstItem="notes-table" firstAttribute="bottom" id="constraint-2" secondItem="notes-safe" secondAttribute="bottom" />
              <constraint firstItem="notes-table" firstAttribute="leading" id="constraint-3" secondItem="notes-safe" secondAttribute="leading" />
              <constraint firstItem="notes-table" firstAttribute="trailing" id="constraint-4" secondItem="notes-safe" secondAttribute="trailing" />
              <constraint firstItem="empty-label" firstAttribute="centerY" id="constraint-5" secondItem="notes-safe" secondAttribute="centerY" />
              <constraint firstItem="empty-label" firstAttribute="leading" id="constraint-6" secondItem="notes-safe" secondAttribute="leading" constant="25" />
              <constraint firstItem="notes-safe" firstAttribute="trailing" id="constraint-7" secondItem="empty-label" secondAttribute="trailing" constant="25" />
            </constraints>
          </view>
          <navigationItem key="navigationItem" title="Notes" id="notes-item">
            <barButtonItem key="leftBarButtonItem" title="Settings" id="settings-bar">
              <connections>
                <action selector="settings:" destination="notes" id="settings-bar-action" />
              </connections>
            </barButtonItem>
            <barButtonItem key="rightBarButtonItem" systemItem="add" id="add-note">
              <connections>
                <action selector="newNote:" destination="notes" id="add-note-action" />
              </connections>
            </barButtonItem>
          </navigationItem>
          <connections>
            <outlet property="tableView" destination="notes-table" id="notes-table-outlet" />
            <outlet property="emptyLabel" destination="empty-label" id="empty-label-outlet" />
          </connections>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="notes-first" sceneMemberID="firstResponder" />
      </objects>
    </scene>
    <scene sceneID="editor-scene">
      <objects>
        <viewController id="editor" sceneMemberID="viewController" storyboardIdentifier="NoteEditor" customClass="NoteEditorViewController" customModule="LorcaIOS" customModuleProvider="target">
          <view key="view" contentMode="scaleToFill" id="editor-view">
            <rect key="frame" x="0" y="0" width="393" height="852" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
            <subviews>
              <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="editor-container">
                <rect key="frame" x="0" y="0" width="393" height="852" />
              </view>
              <button opaque="NO" contentMode="scaleToFill" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="model-status" contentHorizontalAlignment="left">
                <rect key="frame" x="0" y="0" width="349" height="48" />
                <state key="normal" title="Model following" />
                <connections>
                  <action selector="modelOptions:" destination="editor" id="model-status-action" eventType="touchUpInside" />
                </connections>
              </button>
              <activityIndicatorView opaque="NO" contentMode="scaleToFill" hidesWhenStopped="YES" style="medium" translatesAutoresizingMaskIntoConstraints="NO" id="activity">
                <rect key="frame" x="0" y="0" width="20" height="20" />
              </activityIndicatorView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="editor-safe" />
            <constraints>
              <constraint firstItem="editor-container" firstAttribute="top" id="constraint-8" secondItem="editor-safe" secondAttribute="top" />
              <constraint firstItem="editor-container" firstAttribute="leading" id="constraint-9" secondItem="editor-safe" secondAttribute="leading" />
              <constraint firstItem="editor-container" firstAttribute="trailing" id="constraint-10" secondItem="editor-safe" secondAttribute="trailing" />
              <constraint firstItem="model-status" firstAttribute="top" id="constraint-11" secondItem="editor-container" secondAttribute="bottom" constant="4" />
              <constraint firstItem="model-status" firstAttribute="leading" id="constraint-12" secondItem="editor-safe" secondAttribute="leading" constant="18" />
              <constraint firstItem="editor-safe" firstAttribute="trailing" id="constraint-13" secondItem="model-status" secondAttribute="trailing" constant="44" />
              <constraint firstItem="model-status" firstAttribute="bottom" id="editor-bottom" secondItem="editor-safe" secondAttribute="bottom" constant="-8" />
              <constraint firstItem="activity" firstAttribute="centerY" id="constraint-15" secondItem="model-status" secondAttribute="centerY" />
              <constraint firstItem="activity" firstAttribute="trailing" id="constraint-16" secondItem="editor-safe" secondAttribute="trailing" constant="-15" />
            </constraints>
          </view>
          <navigationItem key="navigationItem" title="Note" id="editor-item" />
          <connections>
            <outlet property="editorContainer" destination="editor-container" id="editor-container-outlet" />
            <outlet property="statusButton" destination="model-status" id="model-status-outlet" />
            <outlet property="activity" destination="activity" id="activity-outlet" />
          </connections>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="editor-first" sceneMemberID="firstResponder" />
      </objects>
    </scene>
    <scene sceneID="settings-scene">
      <objects>
        <viewController id="settings" sceneMemberID="viewController" customClass="ConnectionSettingsViewController" customModule="LorcaIOS" customModuleProvider="target">
          <view key="view" contentMode="scaleToFill" id="settings-view">
            <rect key="frame" x="0" y="0" width="393" height="852" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
            <subviews>
              <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="18" translatesAutoresizingMaskIntoConstraints="NO" id="settings-stack">
                <rect key="frame" x="22" y="100" width="349" height="500" />
                <subviews>
                  <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Your model. Your notes." numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="settings-intro">
                    <rect key="frame" x="0" y="0" width="349" height="50" />
                    <fontDescription key="fontDescription" type="system" pointSize="25" />
                  </label>
                  <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Run Ollama on your Mac. On iPhone, enter your Mac’s Wi-Fi address; in Simulator use 127.0.0.1. No API key or account required." numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="settings-help">
                    <rect key="frame" x="0" y="0" width="349" height="50" />
                    <fontDescription key="fontDescription" type="system" pointSize="15" />
                  </label>
                  <textField opaque="NO" contentMode="scaleToFill" borderStyle="roundedRect" placeholder="http://192.168.1.10:11434" translatesAutoresizingMaskIntoConstraints="NO" id="address">
                    <rect key="frame" x="0" y="0" width="349" height="44" />
                    <fontDescription key="fontDescription" type="system" pointSize="17" />
                    <textInputTraits key="textInputTraits" autocapitalizationType="none" autocorrectionType="no" spellCheckingType="no" keyboardType="URL" />
                  </textField>
                  <textField opaque="NO" contentMode="scaleToFill" borderStyle="roundedRect" placeholder="qwen3:14b" translatesAutoresizingMaskIntoConstraints="NO" id="model">
                    <rect key="frame" x="0" y="0" width="349" height="44" />
                    <fontDescription key="fontDescription" type="system" pointSize="17" />
                    <textInputTraits key="textInputTraits" autocapitalizationType="none" autocorrectionType="no" spellCheckingType="no" keyboardType="default" />
                  </textField>
                  <button opaque="NO" contentMode="scaleToFill" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="connect">
                    <rect key="frame" x="0" y="0" width="349" height="48" />
                    <state key="normal" title="Test &amp; Connect" />
                    <connections>
                      <action selector="connect:" destination="settings" id="connect-action" eventType="touchUpInside" />
                    </connections>
                  </button>
                  <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Not connected. Notes always save on this iPhone." numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="status">
                    <rect key="frame" x="0" y="0" width="349" height="50" />
                    <fontDescription key="fontDescription" type="system" pointSize="15" />
                  </label>
                  <button opaque="NO" contentMode="scaleToFill" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="disconnect">
                    <rect key="frame" x="0" y="0" width="349" height="48" />
                    <state key="normal" title="Disconnect" />
                    <connections>
                      <action selector="disconnect:" destination="settings" id="disconnect-action" eventType="touchUpInside" />
                    </connections>
                  </button>
                  <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Inference stays on your Mac. Requests that need current information send a search query to Exa. Use a trusted local network; never expose Ollama to the public internet." numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="privacy">
                    <rect key="frame" x="0" y="0" width="349" height="50" />
                    <fontDescription key="fontDescription" type="system" pointSize="13" />
                  </label>
                </subviews>
              </stackView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="settings-safe" />
            <constraints>
              <constraint firstItem="settings-stack" firstAttribute="top" id="constraint-17" secondItem="settings-safe" secondAttribute="top" constant="22" />
              <constraint firstItem="settings-stack" firstAttribute="leading" id="constraint-18" secondItem="settings-safe" secondAttribute="leading" constant="22" />
              <constraint firstItem="settings-safe" firstAttribute="trailing" id="constraint-19" secondItem="settings-stack" secondAttribute="trailing" constant="22" />
            </constraints>
          </view>
          <navigationItem key="navigationItem" title="Local model" id="settings-item">
            <barButtonItem key="rightBarButtonItem" title="Done" id="settings-done">
              <connections>
                <action selector="done:" destination="settings" id="settings-done-action" />
              </connections>
            </barButtonItem>
          </navigationItem>
          <connections>
            <outlet property="addressField" destination="address" id="address-outlet" />
            <outlet property="modelField" destination="model" id="model-outlet" />
            <outlet property="connectButton" destination="connect" id="connect-outlet" />
            <outlet property="statusLabel" destination="status" id="status-outlet" />
          </connections>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="settings-first" sceneMemberID="firstResponder" />
      </objects>
    </scene>
  </scenes>
</document>